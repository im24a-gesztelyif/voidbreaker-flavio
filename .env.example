# Vercel Project Settings > Environment Variables. Keep these server-side.
# Free option: Metered/OpenRelay complete HTTPS credentials URL from your dashboard.
# Create a free account at https://www.metered.ca/tools/openrelay/
# Keep the account on its free plan and within its monthly relay allowance.
# TURN_CREDENTIALS_URL=https://YOUR_APP.metered.live/api/v1/turn/credentials?apiKey=YOUR_KEY

# Alternative: Cloudflare Realtime TURN key (both values required).
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# Option 3: self-managed TURN client credentials as an ICE server array.
# TURN_ICE_SERVERS=[{"urls":["turns:YOUR_HOST:443?transport=tcp"],"username":"CLIENT_USER","credential":"CLIENT_PASSWORD"}]
